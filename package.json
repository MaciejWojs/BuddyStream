{
  "name": "backend",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "typecheck": "bun check",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.14",
    "@stylistic/eslint-plugin": "^5.10.0",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-seed": "1.0.0-rc.5",
    "eslint": "^10.13.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript-eslint": "^8.72.0"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "bun check",
      "bun lint:fix"
    ]
  }
}
