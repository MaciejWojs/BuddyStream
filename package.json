    "typecheck": "bun check",
    "prepare": "husky"
  },
  "dependencies": {
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "bun check"
    ]
  }
}
