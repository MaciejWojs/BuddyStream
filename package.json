{
  "name": "buddy-stream-backend",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "typecheck": "bun check",
    "prepare": "husky",
    "db-diff": "mise exec -- atlas migrate diff --env local",
    "db-apply": "set -a && . ./.env && set +a && mise exec -- atlas migrate apply --env local --url \"${DATABASE_URL}?sslmode=disable\"",
    "lint": "eslint ",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.20",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.18",
    "zod": "^4.6.7",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "latest",
    "@types/zxcvbn": "^4.4.5",
    "drizzle-seed": "1.0.0-rc.5",
    "eslint": "^10.14.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript-eslint": "^8.72.2"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "bun check",
      "bun lint:fix"
    ]
  }
}
