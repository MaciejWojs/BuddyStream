{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build backend docker image",
      "command": "docker build -t buddy-stream-backend .",
      "type": "shell",
      "presentation": {
        "reveal": "always"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "run infrastructure emulator",
      "options": {
        "cwd": "${workspaceFolder}/infra-local-emulator"
      },
      "command": "docker compose up -d",
      "type": "shell",
      "presentation": {
        "reveal": "always"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run backend server",
      "type": "shell",
      "command": "bun run dev",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Lint backend code",
      "type": "shell",
      "command": "bun run lint",
      "problemMatcher": ["$eslint-stylish"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
