{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build backend docker image",
      "command": "docker build -t buddy-stream-backend .",
      "type": "shell",
      "presentation": {
        "reveal": "always"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "install backend dependencies",
      "command": "bun install --frozen-lockfile --ignore-scripts",
      "type": "shell",
      "presentation": {
        "reveal": "always"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "check for outdated dependencies",
      "command": "bun outdated",
      "type": "shell",
      "presentation": {
        "reveal": "always"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "check for vulnerabilities",
      "command": "bun audit",
      "type": "shell",
      "presentation": {
        "reveal": "always"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": ["check for outdated dependencies"]
    },
    {
      "label": "cleanup",
      "command": "rm -rf dist",
      "type": "shell",
      "presentation": {
        "reveal": "always"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build and run backend in docker compose",
      "command": "docker compose up -d --build",
      "type": "shell",
      "presentation": {
        "reveal": "always"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run backend server",
      "type": "shell",
      "command": "bun run dev",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Lint backend code",
      "type": "shell",
      "command": "bun run lint",
      "problemMatcher": ["$eslint-stylish"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
